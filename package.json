{
  "name": "crisp-search",
  "version": "0.4.0",
  "description": "Launcher-style search for Obsidian, Chinese first.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:host": "node scripts/host-regression.mjs"
  },
  "author": "letschips",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "minisearch": "^7.2.0",
    "pinyin-pro": "^3.29.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
